{
  "SessionStart": [
    {
      "matcher": "startup|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "_NODE=\"$(ls $HOME/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1)\"; [ -z \"$_NODE\" ] && _NODE=\"node\"; _R=\"${CLAUDE_PLUGIN_ROOT:-/home/tiago/pessoal/project-mem/plugin}\"; \"$_NODE\" \"$_R/scripts/startup.cjs\"",
          "timeout": 5,
          "statusMessage": "project-mem iniciando..."
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "_NODE=\"$(ls $HOME/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1)\"; [ -z \"$_NODE\" ] && _NODE=\"node\"; _R=\"${CLAUDE_PLUGIN_ROOT:-/home/tiago/pessoal/project-mem/plugin}\"; \"$_NODE\" \"$_R/scripts/session-init.cjs\"",
          "timeout": 10,
          "statusMessage": "Carregando memória do projeto..."
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit|Bash",
      "hooks": [
        {
          "type": "command",
          "command": "_NODE=\"$(ls $HOME/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1)\"; [ -z \"$_NODE\" ] && _NODE=\"node\"; _R=\"${CLAUDE_PLUGIN_ROOT:-/home/tiago/pessoal/project-mem/plugin}\"; \"$_NODE\" \"$_R/scripts/observe.cjs\"",
          "timeout": 5,
          "async": true
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "_NODE=\"$(ls $HOME/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1)\"; [ -z \"$_NODE\" ] && _NODE=\"node\"; _R=\"${CLAUDE_PLUGIN_ROOT:-/home/tiago/pessoal/project-mem/plugin}\"; \"$_NODE\" \"$_R/scripts/session-end.cjs\"",
          "timeout": 10
        }
      ]
    }
  ]
}
