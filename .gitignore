# Memory directory — commit or ignore, your choice.
# Committing .poupar/ shares full project context with the team.
# Ignoring it keeps memory local to each developer's machine.
# .poupar/

# Temporary session flags (always ignore)
.poupar/tmp/

# Stats cache (regenerated automatically)
.poupar/stats.json

# Auto-synced Claude context (regenerated from PROJECT.md each session)
.claude/CLAUDE.md

# OS
.DS_Store
Thumbs.db

# cluster/seed — pidfiles e network config local
.seed-*.pid
.seed-*.port
.poupar/network.json

# Tarballs de release montados por scripts/package.sh
/dist/

# Backups e notas de sessão — podem conter caminhos locais e dados de projeto
/bkp/
/docs/sessions/
