#!/usr/bin/env bash
# pmem — wrapper de chamadas autenticadas à API local do project-memory,
# montado pra contornar o sandbox `simple_expansion` do Claude Code:
# o agente roda comandos sem `$VAR` na linha; o token é lido aqui dentro.
#
# Subcomandos:
#   handoff <to> <message>       POST /api/agents/handoff
#   handoff-batch <json>         POST /api/agents/handoff_batch  (body literal)
#   subagent <prompt> [tools]    POST /api/agents/subagent/spawn
#   poll <subagent_id>           GET  /api/agents/subagent/<id>
#
# Env esperado (injetado pelo pmem-http no spawn do agente):
#   PROJECT_MEM_AGENT_TOKEN   token Ed25519 do agente
#   CLAUDE_PROJECT_MEM_AGENT  nome do agente (usado como `from` no handoff)
#   PROJECT_MEM_PORT          porta do pmem-http (default 37778)
#
# Sai com código != 0 se algo falhar; mensagem em stderr.

set -euo pipefail

PORT="${PROJECT_MEM_PORT:-37778}"
HOST="${PROJECT_MEM_HOST:-localhost}"
BASE="http://${HOST}:${PORT}"
FROM="${CLAUDE_PROJECT_MEM_AGENT:-unknown}"

die() { echo "pmem: $*" >&2; exit 1; }

if [[ -z "${PROJECT_MEM_AGENT_TOKEN:-}" ]]; then
  die "PROJECT_MEM_AGENT_TOKEN não está no environment. Esse wrapper só roda dentro de agentes spawnados pelo pmem-http."
fi

# Monta um JSON usando jq quando disponível (escape correto). Fallback
# pra concat manual com escapes básicos quando jq não existir — suficiente
# pra mensagens curtas/sem caracteres especiais.
json_handoff() {
  local from="$1" to="$2" msg="$3"
  if command -v jq >/dev/null 2>&1; then
    jq -n --arg from "$from" --arg to "$to" --arg message "$msg" \
       '{from:$from, to:$to, message:$message}'
  else
    printf '{"from":"%s","to":"%s","message":"%s"}\n' \
      "${from//\"/\\\"}" "${to//\"/\\\"}" "${msg//\"/\\\"}"
  fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
  handoff)
    [[ $# -ge 2 ]] || die "uso: pmem handoff <to> <message>"
    to="$1"; shift
    msg="$*"
    body=$(json_handoff "$FROM" "$to" "$msg")
    curl -sS -X POST "${BASE}/api/agents/handoff" \
      -H "Authorization: Bearer ${PROJECT_MEM_AGENT_TOKEN}" \
      -H 'Content-Type: application/json' \
      -d "$body"
    ;;
  handoff-batch)
    [[ $# -ge 1 ]] || die "uso: pmem handoff-batch <json-body>"
    body="$*"
    curl -sS -X POST "${BASE}/api/agents/handoff_batch" \
      -H "Authorization: Bearer ${PROJECT_MEM_AGENT_TOKEN}" \
      -H 'Content-Type: application/json' \
      -d "$body"
    ;;
  subagent)
    [[ $# -ge 1 ]] || die "uso: pmem subagent <prompt> [tool1,tool2,...]"
    prompt="$1"; shift || true
    tools="${1:-Read,Grep,Glob}"
    if command -v jq >/dev/null 2>&1; then
      body=$(jq -n --arg p "$prompt" --arg t "$tools" \
             '{prompt:$p, tools:($t|split(","))}')
    else
      body=$(printf '{"prompt":"%s","tools":["%s"]}' \
             "${prompt//\"/\\\"}" "${tools//,/\",\"}")
    fi
    curl -sS -X POST "${BASE}/api/agents/subagent/spawn" \
      -H "Authorization: Bearer ${PROJECT_MEM_AGENT_TOKEN}" \
      -H 'Content-Type: application/json' \
      -d "$body"
    ;;
  poll)
    [[ $# -ge 1 ]] || die "uso: pmem poll <subagent_id>"
    id="$1"
    curl -sS "${BASE}/api/agents/subagent/${id}" \
      -H "Authorization: Bearer ${PROJECT_MEM_AGENT_TOKEN}"
    ;;
  cron)
    sub="${1:-}"; shift || true
    case "$sub" in
      schedule)
        # cron schedule "<cron-expr>" <target> "<message>"
        [[ $# -ge 3 ]] || die "uso: pmem cron schedule \"<cron-expr>\" <target> \"<message>\""
        schedule="$1"; target="$2"; shift 2
        msg="$*"
        if command -v jq >/dev/null 2>&1; then
          body=$(jq -n --arg s "$schedule" --arg t "$target" --arg m "$msg" \
                 '{schedule:$s, target:$t, message:$m}')
        else
          body=$(printf '{"schedule":"%s","target":"%s","message":"%s"}' \
                 "${schedule//\"/\\\"}" "${target//\"/\\\"}" "${msg//\"/\\\"}")
        fi
        curl -sS -X POST "${BASE}/api/cron" \
          -H "Authorization: Bearer ${PROJECT_MEM_AGENT_TOKEN}" \
          -H 'Content-Type: application/json' \
          -d "$body"
        ;;
      list)
        curl -sS "${BASE}/api/cron"
        ;;
      rm)
        [[ $# -ge 1 ]] || die "uso: pmem cron rm <id>"
        id="$1"
        curl -sS -X DELETE "${BASE}/api/cron/${id}" \
          -H "Authorization: Bearer ${PROJECT_MEM_AGENT_TOKEN}"
        ;;
      ""|help|-h|--help)
        cat <<EOF
pmem cron — agendamento recorrente.

uso:
  pmem cron schedule "<cron-expr>" <target> "<msg>"
  pmem cron list
  pmem cron rm <id>

Formato cron 6-campo: sec min hora dom mês dow (0=domingo).
Atalhos: @hourly, @daily, @weekly, @monthly, @yearly.

Exemplos:
  pmem cron schedule "@hourly" oracle "ronda de status"
  pmem cron schedule "0 0 9 * * 1-5" oracle "bom dia, comece o dia"
  pmem cron schedule "*/30 * * * * *" self "tick a cada 30s"
EOF
        [[ "$sub" == "" ]] && exit 1 || exit 0
        ;;
      *)
        die "subcomando cron desconhecido: $sub (rode 'pmem cron help')"
        ;;
    esac
    ;;
  ""|help|-h|--help)
    cat <<EOF
pmem — wrapper auth pra API do project-memory (porta ${PORT}).

uso:
  pmem handoff <to> <message>        Manda mensagem pra outro agente
  pmem handoff-batch <json>          Batch (N msgs num único POST)
  pmem subagent <prompt> [tools]     Spawna subagent paralelo
  pmem poll <subagent_id>            Status/resultado de subagent
  pmem cron <schedule|list|rm>       Agendamento recorrente (rode 'pmem cron' pra subcomandos)

Token de auth e nome do agente vêm do env (injetado no spawn).
Não use \$VAR diretamente — o sandbox do Claude Code bloqueia.
EOF
    [[ "$cmd" == "" ]] && exit 1 || exit 0
    ;;
  *)
    die "subcomando desconhecido: $cmd (rode 'pmem help')"
    ;;
esac
